# Copy this file to ".env" in the project folder (cp .env.example .env).
# `npm start` reads it automatically. NEVER commit a real .env file.

# PostgreSQL connection string. Same server:  postgresql://sibamotor:PASSWORD@localhost:5432/sibamotor
DATABASE_URL=postgresql://sibamotor:CHANGE_ME@localhost:5432/sibamotor

# Secret used to sign login cookies. At least 32 random characters. REQUIRED in production.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# First admin account (created only if no working admin exists yet).
# Password: at least 10 characters. You will be asked to change it at first login.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# NODE_ENV=production      # set by the PM2 config in docs/DEPLOY-FA.md
# --- optional ---
# DATABASE_SSL=disable      # force SSL off (rarely needed). "require" forces it on.
# DISABLE_CSP=1             # emergency switch: turns off the Content-Security-Policy header
