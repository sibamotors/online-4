# Copy to .env on the server (chmod 600 .env). Never commit the real file.

# PostgreSQL connection string
DATABASE_URL=postgres://sibamotor:CHANGE_ME@127.0.0.1:5432/sibamotor
# Local Postgres on the same server needs no TLS. For a remote host the default is TLS;
# set to "disable" or "require" to override.
# DATABASE_SSL=disable

# Signs login cookies. At least 32 characters. Generate with: openssl rand -hex 32
SESSION_SECRET=

# First admin account, created by `npm run db:migrate`. The password needs 10+ characters
# and must be changed at first login. Remove the password from this file afterwards.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=
# Emergency reset of a forgotten admin password: set to 1, run `npm run db:migrate`, remove again.
# ADMIN_BOOTSTRAP_FORCE=1

# Serve over HTTPS (recommended). Only set to false if the site is reached over plain HTTP.
# COOKIE_SECURE=false

# Where the app listens. Keep it on localhost and put nginx in front.
HOST=127.0.0.1
PORT=3000
NODE_ENV=production

# Notifications in Bale (optional). Create a bot with @botfather in Bale and paste its token.
# Users then link their own chat from their profile (menu → profile → "اعلان در بله").
BALE_BOT_TOKEN=
# Public address of the site, used for the links inside Bale messages (no trailing slash)
APP_URL=https://example.com

# Weekly working hours of one person, used for the capacity bars on the Overview page (default 44)
# WEEKLY_CAPACITY_HOURS=44
